# Telegram
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# Режим: true = только вывод без сохранения в БД, false = рабочий режим с сохранением
DEBUG_MODE=false

# База данных
DATABASE_PATH=matches.db

# ML (XGBoost / CatBoost / MLflow)
ML_CONFIG=config/ml/default.json
ML_ARTIFACTS_DIR=artifacts/ml
# Пусто = локальный artifacts/ml/mlflow.db
MLFLOW_TRACKING_URI=

# Стратегия #8 (1pr) пишется в strategy_predictions автоматически после analyze.
# Внешнее приложение 1pr (c:\papki\work\bets\1pr) — только если ONEPR_EXTERNAL=true
ONEPR_STRATEGY_ONLY=true
ONEPR_EXTERNAL=false
ONEPR_ROOT=c:\papki\work\bets\1pr
ONEPR_USE_DEVIG=true
# ONEPR_HOOK=true  # legacy alias; для внешнего приложения используйте ONEPR_EXTERNAL

# Стратегия #7 Moneyway — корень проекта dogs (пакет arbworld_mw)
DOGS_ROOT=c:\papki\work\bets\dogs

# Стратегия #9 WhoScored — точный счёт + фора с https://www.whoscored.com/previews
# Матчи только из избранных футбольных лиг (italy-serie-a = Италия: Серия А, …)

# Названия листов в Excel-файле
SHEET_ANALYSIS=Анализ
SHEET_ARCHIVE=Архив
SHEET_ODDS=Коэффициенты

# CALC_BACKEND=python — расчёт без Excel (кэш формул)
CALC_BACKEND=python
FORMULA_PURE_EVAL=true
# CALC_WORKBOOK нужен только для пересборки кэша / опции --excel
# CALC_WORKBOOK=DeluX_IncoProrok_mvp0.xlsm

# Проверка результатов матчей (match_checker.py)
# true = только вывод получаемых/заполняемых данных без записи в БД
MATCH_CHECKER_DEBUG_MODE=false
MATCH_API_URL=http://127.0.0.1:5000
MATCH_API_POLL_INTERVAL_SEC=60

# Моковый API (mock_match_api.py)
MOCK_MATCH_API_PORT=5000
